# ─── Web client (Vite) ─────────────────────────────────────────────
# Base URL of the game API. Leave empty for local prototype (no server).
VITE_API_URL=
# Public Razorpay key id (test mode in development). Server holds the secret.
VITE_RAZORPAY_KEY_ID=

# ─── Game server (Fastify) — M3+ ──────────────────────────────────
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://barricade:barricade@localhost:5432/barricade
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-32-byte-random-hex
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ─── Razorpay (server only) ───────────────────────────────────────
# Never expose the secret to the client or commit it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PLUS=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_ELITE=
# When unset the server runs in safe test mode and NEVER marks a payment paid.
BILLING_MODE=test

# ─── Deployment ───────────────────────────────────────────────────
VERCEL_TOKEN=
