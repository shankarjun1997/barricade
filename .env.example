# ── Web client (Vite) ─────────────────────────────────────────────
# Base URL of the game API. Empty in Phase C.
VITE_API_URL=
# Public Razorpay key id (test mode in development). Server holds the secret.
VITE_RAZORPAY_KEY_ID=
# WebSocket URL of the authoritative game server. In production use wss://.
# Local dev defaults to ws://localhost:8787/ws when this is empty.
VITE_WS_URL=

# ── Online game server (Fastify + WebSocket) ─────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins allowed to open a WebSocket.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://barricade-ruby.vercel.app
# JSON persistence path. Set to "none" to disable persistence in development.
DATA_FILE=./data/state.json
RECONNECT_GRACE_MS=60000
LOG_LEVEL=info

# ── Reserved for Phase B accounts/billing (not used by the game server yet)
DATABASE_URL=postgresql://barricade:barricade@localhost:5432/barricade
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-32-byte-random-hex
CORS_ORIGIN=http://localhost:5173

# Razorpay (server only). Never expose the secret to the client or commit it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PLUS=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_ELITE=
BILLING_MODE=test
